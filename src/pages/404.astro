---
import { siteConfig } from "../config";
import "../styles/global.css";
const accent = siteConfig.accentColor;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>404 · {siteConfig.name}</title>
    <meta name="theme-color" content="#060a13" />
  </head>
  <body
    class="min-h-screen flex items-center justify-center"
    style={`--accent-color: ${accent}`}
  >
    <div class="text-center px-8">
      <p class="font-mono text-6xl sm:text-8xl font-bold" style={{ color: accent }}>
        404
      </p>
      <h1 class="mt-6 text-xl sm:text-2xl font-semibold text-slate-100">
        页面不存在或已被移除
      </h1>
      <p class="mt-3 font-mono text-sm text-slate-500">
        $ cd ~/ &amp;&amp; ls
      </p>
      <a
        href="/"
        class="mt-10 inline-block rounded-lg px-6 py-3 text-sm font-semibold text-[#041018] transition hover:brightness-110"
        style={{ backgroundColor: accent }}
      >
        返回首页
      </a>
    </div>
  </body>
</html>
