---
import { siteConfig } from "../config";
import WorksCarousel from "./WorksCarousel.astro";
const accent = siteConfig.accentColor;
const s = siteConfig.social;
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-[#060a13] pt-24 md:pt-28"
  style={`--accent-color: ${accent}`}
>
  <!-- 背景光晕与网格（仅装饰层） -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="pointer-events-none absolute -top-44 -left-32 size-[520px] rounded-full opacity-15 blur-[120px]"
      style={{ background: accent }}
    ></div>
    <div
      class="pointer-events-none absolute -bottom-64 -right-40 size-[500px] rounded-full bg-violet-600 opacity-10 blur-[130px]"
    ></div>
    <svg
      aria-hidden="true"
      class="absolute inset-0 size-full [mask-image:radial-gradient(80%_70%_at_50%_0%,black,transparent_80%)]"
    >
      <defs>
        <pattern id="hero-grid2" width="52" height="52" patternUnits="userSpaceOnUse">
          <path d="M52 0H0V52" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid2)" />
    </svg>
  </div>

  <div class="relative z-10">
    <!-- 标题区 -->
    <div class="mx-auto max-w-4xl px-6 pt-14 text-center sm:px-8 md:pt-20">
      <p class="animate-fade-in font-mono text-sm text-slate-300 sm:text-base" style={{ color: accent }}>
        ~/portfolio $ whoami
      </p>
      <h1
        class="mt-7 animate-fade-in animation-delay-200 text-4xl font-bold tracking-tight text-white sm:text-6xl md:text-7xl"
      >
        你好，我是&nbsp;
        <span
          class="inline-block"
          style={`color: ${accent}; text-shadow: 0 0 34px ${accent}66`}
          >{siteConfig.name}</span
        >
        <span class="align-middle">&nbsp;👋</span>
      </h1>
    </div>

    <!-- 3D 上下滚动作品轮播 -->
    <WorksCarousel demoMode={siteConfig.demoMode} />

    <!-- CTA 按钮 -->
    <div class="relative z-10 mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-4 px-6 pb-14 sm:px-8">
      <a
        href="#showcase"
        class="rounded-lg px-7 py-3 text-sm font-semibold text-[#041018] transition hover:brightness-110"
        style={`background-color:${accent}; box-shadow:0 0 28px ${accent}55`}
      >
        浏览作品集 →
      </a>
      <a
        href="#downloads"
        class="rounded-lg border border-white/15 px-7 py-3 text-sm font-medium text-slate-200 transition hover:border-white/35 hover:bg-white/5"
      >
        前往下载中心
      </a>
    </div>

    <!-- 社交链接 -->
    <div class="relative z-10 flex items-center justify-center gap-x-7 pb-12">
      {
        s.email && (
          <a
            href={`mailto:${s.email}`}
            aria-label="Email"
            class="text-slate-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" /></svg>
          </a>
        )
      }
      {
        s.github && (
          <a
            href={s.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-slate-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" /></svg>
          </a>
        )
      }
      {
        s.twitter && (
          <a
            href={s.twitter}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter / X"
            class="text-slate-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 4l11.733 16h4.267l-11.733 -16z" /><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" /></svg>
          </a>
        )
      }
      {
        s.linkedin && (
          <a
            href={s.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-slate-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 1 0 -4 0" /><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" /></svg>
          </a>
        )
      }
    </div>
  </div>
</div>
