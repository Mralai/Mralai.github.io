---
import { siteConfig } from "../config";
const accent = siteConfig.accentColor;
const items = siteConfig.education ?? [];
const hasEducation = items.length > 0;
const chipDemo =
  "inline-flex items-center rounded-full border border-amber-300/40 bg-amber-400/10 px-2.5 py-0.5 font-mono text-[11px] text-amber-300";
---

{
  hasEducation && (
    <section id="education" class="px-6 sm:px-8 py-16 sm:py-20 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <p class="font-mono text-sm tracking-widest" style={{ color: accent }}>
              # education
            </p>
            <h2 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-white">
              教育
            </h2>
            <div
              class="mt-4 w-[75px] h-[5px] rounded-full"
              style={`background-color: ${accent}; box-shadow: 0 0 12px ${accent}`}
            ></div>
          </div>

          <div class="lg:col-span-8 space-y-6">
            {items.map((edu) => (
              <div
                class="card-glow rounded-2xl border border-white/10 border-l-2 bg-white/5 p-5 sm:p-6 transition-all duration-300 hover:bg-white/[0.07] hover:border-white/20"
                style={{ borderLeftColor: accent }}
              >
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-lg sm:text-xl font-semibold text-white">
                      {edu.degree}
                    </h3>
                    {edu.isDemo && <span class={chipDemo}>示例数据</span>}
                  </div>
                  <span class="shrink-0 font-mono text-xs text-slate-500">
                    {edu.dateRange}
                  </span>
                </div>
                <p class="mt-1 text-base" style={{ color: accent }}>
                  {edu.school}
                </p>

                <ul class="mt-4 space-y-2.5">
                  {edu.achievements.map((item) => (
                    <li class="flex items-start">
                      <span
                        class="mt-2.5 mr-3 inline-block size-1.5 shrink-0 rounded-full"
                        style={{ backgroundColor: accent }}
                      ></span>
                      <span class="text-sm leading-relaxed text-slate-400 sm:text-base">
                        {item}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
