---
import { siteConfig } from "../config";
const accent = siteConfig.accentColor;
const downloads = siteConfig.downloads ?? [];
const hasDownloads = downloads.length > 0;
const chipDemo =
  "inline-flex items-center rounded-full border border-amber-300/40 bg-amber-400/10 px-2.5 py-0.5 font-mono text-[11px] text-amber-300";
---

{
  hasDownloads && (
    <section id="downloads" class="px-6 sm:px-8 py-16 sm:py-20 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <p class="font-mono text-sm tracking-widest" style={{ color: accent }}>
              # downloads
            </p>
            <h2 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-white">
              下载中心
            </h2>
            <div
              class="mt-4 w-[75px] h-[5px] rounded-full"
              style={`background-color: ${accent}; box-shadow: 0 0 12px ${accent}`}
            ></div>
            <p class="mt-6 leading-relaxed text-slate-400">
              软件与源码包免费下载。小文件直接由本站托管；大文件通过 GitHub
              Releases 分发（下载更快、版本可追溯）。
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-4">
              {downloads.map((item) => (
                <div
                  class="card-glow flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 rounded-2xl border border-white/10 bg-white/5 p-5 sm:p-6 transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/[0.07] hover:border-white/20"
                >
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="font-mono text-base sm:text-lg font-semibold text-white">
                        {item.name}
                      </h3>
                      {item.isDemo && <span class={chipDemo}>示例数据</span>}
                    </div>
                    <p class="mt-1.5 text-sm leading-relaxed text-slate-400">
                      {item.desc}
                    </p>
                    <p class="mt-2.5 font-mono text-xs text-slate-500">
                      v{item.version} · {item.platform} · {item.size}
                    </p>
                  </div>

                  <a
                    href={item.url}
                    class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold text-[#041018] transition hover:brightness-110"
                    style={{ backgroundColor: accent }}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4 w-4"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M12 3v12" />
                      <path d="M7 11l5 5l5 -5" />
                      <path d="M5 21h14" />
                    </svg>
                    下载
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
