---
import { siteConfig } from "../config";
const accent = siteConfig.accentColor;
---

<section id="about" class="px-6 py-16 sm:px-8 md:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-1 items-start gap-8 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-4">
        <p class="font-mono text-sm tracking-widest" style={{ color: accent }}>
          # about
        </p>
        <h2 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">
          关于我
        </h2>
        <div
          class="mt-4 w-[75px] h-[5px] rounded-full"
          style={`background-color: ${accent}; box-shadow: 0 0 12px ${accent}`}
        ></div>
      </div>

      <div class="space-y-6 md:col-span-8">
        {siteConfig.aboutMe.map((paragraph) => (
          <p class="text-lg leading-relaxed text-slate-400 sm:text-xl">
            {paragraph}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>
