---
import { siteConfig } from "../config";
const accent = siteConfig.accentColor;
---

<section id="about" class="px-6 sm:px-8 py-16 sm:py-20 md:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <p class="font-mono text-sm tracking-widest" style={{ color: accent }}>
          # about
        </p>
        <h2 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-white">
          关于我
        </h2>
        <div
          class="mt-4 w-[75px] h-[5px] rounded-full"
          style={`background-color: ${accent}; box-shadow: 0 0 12px ${accent}`}
        ></div>
      </div>

      <div class="lg:col-span-8 space-y-6">
        {siteConfig.aboutMe.map((paragraph) => (
          <p class="text-lg sm:text-xl leading-relaxed text-slate-400">
            {paragraph}
          </p>
        ))}

        <div class="pt-4 flex flex-wrap gap-3">
          {siteConfig.skills.map((skill) => (
            <span
              class="rounded-full border border-white/10 bg-white/5 px-3 sm:px-4 py-1.5 font-mono text-sm sm:text-base text-slate-300 transition-colors hover:border-white/25 hover:text-white"
            >
              {skill}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
