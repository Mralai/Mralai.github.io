---
import { siteConfig } from "../config";
const accent = siteConfig.accentColor;
const year = new Date().getFullYear();
const nav = [
  { href: "#about", label: "关于" },
  { href: "#showcase", label: "作品集" },
  { href: "#downloads", label: "下载中心" },
];
const s = siteConfig.social;
---

<footer class="border-t border-white/5 bg-[#04070d]">
  <div class="mx-auto max-w-7xl px-6 py-12 sm:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <p class="font-mono text-lg font-semibold text-white">
          <span style={{ color: accent }}>$</span>&nbsp;{siteConfig.name}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-slate-500">
          {siteConfig.title} · {siteConfig.description}
        </p>

        <div class="mt-5 flex gap-x-6">
          {s.email && (
            <a
              href={`mailto:${s.email}`}
              aria-label="Email"
              class="text-slate-500 transition-colors duration-300 hover:text-[var(--accent-color)]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" /></svg>
            </a>
          )}
          {s.github && (
            <a
              href={s.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="text-slate-500 transition-colors duration-300 hover:text-[var(--accent-color)]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" /></svg>
            </a>
          )}
          {s.twitter && (
            <a
              href={s.twitter}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Twitter / X"
              class="text-slate-500 transition-colors duration-300 hover:text-[var(--accent-color)]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 4l11.733 16h4.267l-11.733 -16z" /><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" /></svg>
            </a>
          )}
          {s.linkedin && (
            <a
              href={s.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="text-slate-500 transition-colors duration-300 hover:text-[var(--accent-color)]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 1 0 -4 0" /><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" /></svg>
            </a>
          )}
        </div>
      </div>

      <div class="md:text-right">
        <nav class="flex flex-col items-start gap-3 md:items-end">
          {nav.map((l) => (
            <a
              href={l.href}
              class="text-sm text-slate-500 transition-colors hover:text-white"
            >
              {l.label}
            </a>
          ))}
        </nav>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 md:flex-row">
      <p class="font-mono text-xs text-slate-600">
        © {year} {siteConfig.name} · Built with Astro ·
        模板
        <a
          href="https://github.com/RyanFitzgerald/devportfolio"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-slate-400"
          >DevPortfolio</a
        >
        (MIT)
      </p>
      {siteConfig.demoMode && (
        <p class="font-mono text-xs text-amber-300/80">
          ⚠ demoMode：作品与下载为演示素材，编辑 src/data/works.ts 与 src/config.ts 即可替换
        </p>
      )}
    </div>
  </div>
</footer>
